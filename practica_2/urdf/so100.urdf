<robot name="so100">
    <!--Informacion de eslabones-->

    <!--cajita del sistema 0-->
<link name="base_link">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
            <mesh filename="Base.STL" scale="1 1 1"/>
            <!--CYLINDER, MESH O BOX, AGUAS CON LA DOBLE ETIQUETA-->
        </geometry>
    </visual>
    
   
</link>

    <!--cajita del sistema 1-->
<link name="shoulder_link">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0"/>
        <geometry>
            <mesh filename="Shoulder_Rotation_Pitch.STL" scale="1 1 1"/>
                    <!--CYLINDER, MESH O BOX, AGUAS CON LA DOBLE ETIQUETA-->
        </geometry>
    </visual>
</link>

<link name="UpperArm_link">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 1.57 0.0"/>
        <geometry>
            <mesh filename="Upper_Arm.STL" scale="1 1 1"/>
                    <!--CYLINDER, MESH O BOX, AGUAS CON LA DOBLE ETIQUETA-->
        </geometry>
    </visual>
</link>

<link name="LowerArm_link">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy=" 1.57 1.57 0"/>
        <geometry>
            <mesh filename="Lower_Arm.STL" scale="1 1 1"/>
                    <!--CYLINDER, MESH O BOX, AGUAS CON LA DOBLE ETIQUETA-->
        </geometry>
    </visual>
</link>  


<link name="WristPitchRoll_link">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy=" 1.57 1.57 0"/>
        <geometry>
            <mesh filename="Wrist_Pitch_Roll.STL" scale="1 1 1"/>
                    <!--CYLINDER, MESH O BOX, AGUAS CON LA DOBLE ETIQUETA-->
        </geometry>
    </visual>
</link>  


<link name="FixedGripper_link">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="1.57 0 -1.57"/>
        <geometry>
            <mesh filename="Fixed_Gripper.STL" scale="1 1 1"/>
                    <!--CYLINDER, MESH O BOX, AGUAS CON LA DOBLE ETIQUETA-->
        </geometry>
    </visual>
</link> 1.57 1.57


<link name="MovingJaw_link">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
        <geometry>
            <mesh filename="Moving_Jaw.STL" scale="1 1 1"/>
                    <!--CYLINDER, MESH O BOX, AGUAS CON LA DOBLE ETIQUETA-->
        </geometry>
    </visual>
</link> 

<!--1joint-->
<joint name="shoulder_joint" type="revolute">
    <origin xyz="0.0 -0.045 0.016" rpy="0.0 0.0 0.0"/>
   <!--eslbon padre y eslabon fijo, eslabones se llaman link-->
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <!--pongo 0.1 en z porque alli rota-->
    <axis xyz="0.0 0.0 1.0"/>
    <!--limites en radianes -->
    <limit lower="-3.14" upper="3.14" effort="1.0" velocity="10.0"/> <!-- velocity en rad/s-->
</joint>
<joint name="UpperArm_joint" type="revolute">
    <origin xyz="0.0 -0.0306  0.1024" rpy="0.0 -1.57 -0.0"/>
   <!--eslbon padre y eslabon fijo, eslabones se llaman link-->
    <parent link="shoulder_link"/>
    <child link="UpperArm_link"/>
    <!--pongo 0.1 en z porque alli rota-->
    <axis xyz="0.0 0.0 1.0"/>
    <!--limites en radianes -->
    <limit lower="-3.14" upper="3.14" effort="1.0" velocity="10.0"/> <!-- velocity en rad/s-->
</joint>


<joint name="LowerArm_joint" type="revolute">
    <origin xyz="0.028 0.112 0" rpy="0 0 0"/>
   <!--eslbon padre y eslabon fijo, eslabones se llaman link-->
    <parent link="UpperArm_link"/>
    <child link="LowerArm_link"/>
    <!--pongo 0.1 en z porque alli rota-->
    <axis xyz="0.0 0.0 1.0"/>
    <!--limites en radianes -->
    <limit lower="-3.14" upper="3.14" effort="1.0" velocity="10.0"/> <!-- velocity en rad/s-->
</joint>

<joint name="WristPitchRoll_joint" type="revolute">
    <origin xyz="0 -0.134 0" rpy="0 0.0 1.57"/>
   <!--eslbon padre y eslabon fijo, eslabones se llaman link-->
    <parent link="LowerArm_link"/>
    <child link="WristPitchRoll_link"/>
    <!--pongo 0.1 en z porque alli rota-->
    <axis xyz="0.0 0.0 1.0"/>
    <!--limites en radianes -->
    <limit lower="-3.14" upper="3.14" effort="1.0" velocity="10.0"/> <!-- velocity en rad/s-->
</joint>


<joint name="FixedGripper_joint" type="revolute">
    <origin xyz="-0.0625 0 0 " rpy="1.57 0 1.57"/>
   <!--eslbon padre y eslabon fijo, eslabones se llaman link-->
    <parent link="WristPitchRoll_link"/>
    <child link="FixedGripper_link"/>
    <!--pongo 0.1 en z porque alli rota-->
    <axis xyz="0 0 1"/>
    <!--limites en radianes -->
    <limit lower="-3.14" upper="3.14" effort="1.0" velocity="10.0"/> <!-- velocity en rad/s-->
</joint>


  <joint name="MovingJaw_joint" type="revolute">
    <origin xyz="0 0.0244 -0.0202 " rpy="1.57 0 1.57"/>
   <!--eslbon padre y eslabon fijo, eslabones se llaman link-->
    <parent link="FixedGripper_link"/>
    <child link="MovingJaw_link"/>
    <!--pongo 0.1 en z porque alli rota-->
    <axis xyz="0 0 1.0"/>
    <!--limites en radianes -->
    <limit lower="-3.14" upper="3.14" effort="1.0" velocity="10.0"/> <!-- velocity en rad/s-->
</joint>

</robot>